{
  "display_information": {
    "name": "Eden Gen",
    "description": "Show help and the connected workspace balance. Does not spend credit.",
    "background_color": "#111114"
  },
  "features": {
    "bot_user": {
      "display_name": "Eden Gen",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/edengen",
        "url": "https://edengen.ai/api/slack/commands",
        "description": "Help, or the connected workspace balance",
        "usage_hint": "help | balance",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": ["https://edengen.ai/api/slack/oauth"],
    "scopes": {
      "bot": ["commands"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
